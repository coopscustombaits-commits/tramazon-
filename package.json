{
  "name": "coops-custom-baits",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "emulators": "firebase emulators:start --only firestore,auth,storage --project demo-coops",
    "test:rules": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node --test \"tests/**/*.test.mjs\"",
    "ci": "npm run typecheck && npx eslint . && npm run test:unit && npm --prefix functions run build && npx firebase emulators:exec --only firestore --project demo-coops \"npm run test:rules\"",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test": "npm run test:unit && npx firebase emulators:exec --only firestore --project demo-coops \"npm run test:rules\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "expo": "~57.0.11",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.6",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-mail-composer": "~57.0.1",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "firebase-tools": "^15.26.0",
    "typescript": "~6.0.3"
  }
}
