# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real values.
#
# Anything prefixed with EXPO_PUBLIC_ is inlined into the JS bundle and is
# therefore readable by anyone who downloads the app. That's expected and fine
# for Firebase web config and the Shopify *Storefront* token, both of which are
# designed to be public. Access control is enforced by Firestore security rules
# and by Shopify, not by hiding these values.
#
# NEVER put a Shopify Admin API token, a Firebase service account key, or any
# private key in here.

# ---------------------------------------------------------------------------
# Firebase (Project settings -> General -> Your apps -> Web app config)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=coops-custom-baits.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=coops-custom-baits
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=coops-custom-baits.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Google Sign-In (Google Cloud console -> Credentials -> OAuth 2.0 client IDs)
# Firebase creates most of these for you when you enable the Google provider.
# ---------------------------------------------------------------------------
# "Web application" client ID. Required on BOTH platforms — it is what Firebase
# validates the ID token against.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# "iOS" client ID. Also used to build the iOS URL scheme in app.config.ts.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Your Firebase Auth uid. Used only to decide whether to show the "Review"
# entry point in the UI; enforcement happens in firestore.rules.
EXPO_PUBLIC_ADMIN_UID=

# ---------------------------------------------------------------------------
# Shopify Storefront API — see docs/SETUP.md section 8.
# The Shop tab shows "store coming soon" until the domain and token are set.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=coops-custom-baits.myshopify.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
EXPO_PUBLIC_SHOPIFY_API_VERSION=2026-04

# ---------------------------------------------------------------------------
# EAS
# ---------------------------------------------------------------------------
EAS_PROJECT_ID=
