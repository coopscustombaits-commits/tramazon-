rules_version = '2';

// Security rules for Coop's Custom Baits.
//
// The rules — not the app UI — are what actually enforce the moderation
// workflow. Anyone can talk to Firestore directly with the public API key, so
// everything important is checked here:
//
//   * A post can only be created as `pending`.
//   * Only an admin can move a post to `approved` or `rejected`.
//   * Only `approved` posts are readable by other users.
//   * Counters (likeCount, commentCount, postCount) are written by Cloud
//     Functions with the Admin SDK, which bypasses these rules, so clients
//     can never inflate them.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin is granted by the existence of an `admins/{uid}` document, created
    // by hand in the Firebase console. See docs/SETUP.md.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Fields the request is trying to change.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isValidString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    /**
     * A suspended or banned account can still read and can still sign in, but
     * cannot create anything. Only an admin can change `accountStatus` — the
     * profile update rule below excludes the field, so nobody can lift their
     * own ban.
     *
     * This costs one document read per write. That's the price of enforcing it
     * where it can't be bypassed, rather than in app code a modified client
     * would simply skip.
     */
    function accountActive() {
      // The `exists` check is not redundant: `get()` on a missing document
      // returns null, and reading `.data` off it is an evaluation error rather
      // than a clean deny. Someone mid-signup, or whose account was deleted in
      // another session, hits exactly that path.
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.accountStatus == 'active';
    }

    // ---------------------------------------------------------------------
    // users/{uid} — public profile
    // ---------------------------------------------------------------------
    match /users/{uid} {
      // Profiles are public so the feed can show who posted what.
      allow read: if isSignedIn();

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && isValidString(request.resource.data.username, 20)
        && request.resource.data.username.size() >= 3
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && isValidString(request.resource.data.bio, 200)
        // Counters always start at zero; only the server moves them after that.
        && request.resource.data.postCount == 0
        && request.resource.data.fishLoggedCount == 0
        && request.resource.data.points == 0
        && request.resource.data.followerCount == 0
        && request.resource.data.followingCount == 0
        // Nobody signs themselves up pre-banned or pre-cleared of a ban.
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.suspendedUntil == null;

      allow update: if isSelf(uid)
        // Owners may edit presentation fields only. Counters and uid are
        // server-managed; username changes also touch /usernames, which has
        // its own rules below.
        && changedKeys().hasOnly([
             'bio', 'photoURL', 'favoriteSpecies', 'username', 'usernameLower',
             'providers', 'updatedAt'
           ])
        && (!changedKeys().hasAny(['bio']) || isValidString(request.resource.data.bio, 200))
        && (!changedKeys().hasAny(['username']) || (
             isValidString(request.resource.data.username, 20)
             && request.resource.data.username.size() >= 3
             && request.resource.data.usernameLower == request.resource.data.username.lower()
           ));

      // "Delete account" removes the profile as the user, together with their
      // username reservation, so the name is released immediately. Cascading
      // cleanup of posts and photos is handled by a Cloud Function.
      allow delete: if isSelf(uid);

      // users/{uid}/private/profile — email, notification prefs.
      match /private/{document=**} {
        allow read, write: if isSelf(uid);
      }

      // users/{uid}/pushTokens/{token} — one per device.
      match /pushTokens/{token} {
        allow read, write: if isSelf(uid);
      }

      // users/{uid}/notifications/{id} — written by Cloud Functions; the user
      // may read them and mark them read.
      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid) && changedKeys().hasOnly(['readAt']);
        allow create, delete: if false;
      }

      // users/{uid}/blocked/{blockedUid} — private to the owner.
      //
      // Deliberately not readable by the person who was blocked: they are
      // never told, which is the whole point of a block rather than a ban.
      match /blocked/{blockedUid} {
        allow read, write: if isSelf(uid);
      }

      // users/{uid}/wishlist/{productId} — entirely the owner's own list.
      match /wishlist/{productId} {
        allow read, write: if isSelf(uid);
      }

      // users/{uid}/orders/{orderId}
      //
      // The client records an order when checkout opens, but everything after
      // that — order number, status, tracking — is written by the Cloud
      // Function that receives Shopify's webhooks. Letting a client set its
      // own order to "fulfilled" would make the whole screen meaningless.
      match /orders/{orderId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.status == 'placed'
          && request.resource.data.shopifyOrderId == null
          && request.resource.data.orderNumber == null
          && request.resource.data.statusUrl == null
          && request.resource.data.cartId is string;
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // usernames/{usernameLower} — uniqueness reservations
    // ---------------------------------------------------------------------
    match /usernames/{usernameLower} {
      // Readable so the sign-up screen can check availability before writing.
      allow read: if true;
      // You may only claim a name for yourself, and only if it's unclaimed.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Releasing your own reservation (part of a rename transaction).
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      // Re-writing a reservation you already own — happens when profile
      // setup is retried after a partial failure. Never a takeover.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // admins/{uid}
    // ---------------------------------------------------------------------
    match /admins/{uid} {
      // A user may check whether they themselves are an admin, nothing more.
      allow get: if isSelf(uid);
      allow list, write: if false;
    }

    // ---------------------------------------------------------------------
    // follows/{followerId}_{followingId}
    // ---------------------------------------------------------------------
    match /follows/{edgeId} {
      // Public so a profile can show follower and following lists.
      allow read: if isSignedIn();

      // You can only create an edge where you are the follower, and the
      // document id has to match — otherwise one write could claim any edge.
      allow create: if accountActive()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && edgeId == request.auth.uid + '_' + request.resource.data.followingId;

      // Unfollowing is yours. So is being unfollowed — a user can remove a
      // follower, which is what "remove follower" means on every other app.
      allow delete: if isSignedIn() && (
           resource.data.followerId == request.auth.uid
           || resource.data.followingId == request.auth.uid
         );

      // Counters are derived from these edges; editing one would desync them.
      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // reports/{reportId}
    //
    // A reporter may file one and nothing else. They cannot read the queue,
    // edit their report, or see the outcome — any of those would reveal who
    // reported whom, which is exactly what a reporting system must not do.
    // ---------------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAdmin();

      allow create: if accountActive()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['post', 'comment', 'user', 'message']
        && request.resource.data.targetId is string
        && request.resource.data.targetOwnerId is string
        // Reporting yourself is meaningless and would only muddy the queue.
        && request.resource.data.targetOwnerId != request.auth.uid
        && isValidString(request.resource.data.note, 500)
        && request.resource.data.status == 'open'
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null;

      allow update: if isAdmin()
        && changedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'updatedAt'])
        && request.resource.data.status in ['actioned', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid;

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // announcements/{announcementId}
    //
    // Creating one is what triggers the fan-out to every registered device, so
    // only an admin may write here. Everyone can read them so the app can show
    // a "news" list without waiting on a push.
    // ---------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && isValidString(request.resource.data.title, 100)
        && request.resource.data.title.size() > 0
        && isValidString(request.resource.data.body, 500)
        && request.resource.data.body.size() > 0
        // `sentAt` and `recipientCount` are the Cloud Function's to set — an
        // announcement that claims to have already been sent would never go out.
        && request.resource.data.sentAt == null
        && request.resource.data.recipientCount == 0;
      // Editing after the push has gone out would leave the two disagreeing.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // posts/{postId}
    // ---------------------------------------------------------------------
    match /posts/{postId} {

      function isApproved() {
        return resource.data.status == 'approved';
      }

      function isAuthor() {
        return isSignedIn() && resource.data.authorId == request.auth.uid;
      }

      // Search keywords come from the client, so cap them. MAX_KEYWORDS in
      // src/lib/search.ts is 40 — keep the two in step.
      //
      // Absence passes: a post without keywords simply doesn't turn up in
      // search, which is a feature gap and not a security problem. Requiring
      // the field would instead make every pre-search post uneditable.
      function validKeywords() {
        return !('keywords' in request.resource.data)
          || (request.resource.data.keywords is list
              && request.resource.data.keywords.size() <= 40);
      }

      // Signed-in users see approved posts; you can always see your own (so
      // you can watch it move through review); admins see everything.
      // Sign-in is required deliberately — the whole app is behind auth, and
      // without this check anyone with the public API key could scrape the
      // feed. Relax it only if there's ever a public web version.
      allow read: if isSignedIn() && (isApproved() || isAuthor() || isAdmin());

      allow create: if accountActive()
        && request.resource.data.authorId == request.auth.uid
        // Nothing goes live without review.
        && request.resource.data.status == 'pending'
        && request.resource.data.publishedAt == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && isValidString(request.resource.data.caption, 2000)
        && request.resource.data.media.url is string
        && request.resource.data.media.storagePath is string
        && request.resource.data.media.kind in ['photo', 'video']
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.reportCount == 0
        // Search keywords are client-computed, so they need a ceiling — a huge
        // array is a cheap way to bloat the document and the index.
        && validKeywords()
        // Only an admin decides what gets featured.
        && request.resource.data.featured == false;

      // Authors may fix a caption, but only while the post is still pending —
      // an approved post can't be edited into something else after the fact.
      // `keywords` rides along because it's derived from the caption and the
      // species; leaving it out would let an edit desync search from content.
      allow update: if isAuthor()
        && resource.data.status == 'pending'
        && changedKeys().hasOnly([
             'caption', 'species', 'speciesSlug', 'keywords', 'updatedAt'
           ])
        && isValidString(request.resource.data.caption, 2000)
        && validKeywords();

      // Moderation. Only admins, and only into a terminal state.
      allow update: if isAdmin()
        && changedKeys().hasOnly([
             'status', 'publishedAt', 'reviewedAt', 'reviewedBy', 'reviewNote', 'updatedAt'
           ])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;

      // Featuring a post on the home page. Separate from review so an admin
      // can pin something without it counting as a fresh moderation decision.
      allow update: if isAdmin() && changedKeys().hasOnly(['featured', 'updatedAt']);

      allow delete: if isAuthor() || isAdmin();

      // posts/{postId}/likes/{uid} — document id is the liker.
      match /likes/{likerId} {
        allow read: if isSignedIn();
        // Only on approved posts, only your own like. Removing a like is
        // allowed even while suspended — undoing something is never the
        // behaviour a ban is meant to stop.
        allow create: if isSelf(likerId)
          && accountActive()
          && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'approved';
        allow delete: if isSelf(likerId);
        allow update: if false;
      }

      // posts/{postId}/comments/{commentId}
      match /comments/{commentId} {
        allow read: if isSignedIn();

        allow create: if accountActive()
          && request.resource.data.authorId == request.auth.uid
          && isValidString(request.resource.data.text, 1000)
          && request.resource.data.text.size() > 0
          && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'approved';

        allow update: if isSignedIn()
          && resource.data.authorId == request.auth.uid
          && changedKeys().hasOnly(['text', 'updatedAt'])
          && isValidString(request.resource.data.text, 1000);

        // Your own comment, or anything on a post you own, or admin.
        allow delete: if isSignedIn() && (
             resource.data.authorId == request.auth.uid
             || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
             || isAdmin()
           );
      }
    }

    // Anything not matched above is denied. Later phases (follows, messages,
    // tournaments, badges) add their own blocks here.
  }
}
