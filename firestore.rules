rules_version = '2';

// Security rules for Coop's Custom Baits.
//
// The rules — not the app UI — are what actually enforce the moderation
// workflow. Anyone can talk to Firestore directly with the public API key, so
// everything important is checked here:
//
//   * A post can only be created as `pending`.
//   * Only an admin can move a post to `approved` or `rejected`.
//   * Only `approved` posts are readable by other users.
//   * Counters (likeCount, commentCount, postCount) are written by Cloud
//     Functions with the Admin SDK, which bypasses these rules, so clients
//     can never inflate them.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin is granted by the existence of an `admins/{uid}` document, created
    // by hand in the Firebase console. See docs/SETUP.md.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Fields the request is trying to change.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isValidString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // The other uid in a two-person list. Only meaningful where the list is
    // already known to have exactly two entries, one of which is the caller.
    function otherIn(uids) {
      return uids.removeAll([request.auth.uid])[0];
    }

    /**
     * Is this competition accepting entries right now?
     *
     * Checked here and not only in the app, because "the contest closed an
     * hour ago" is exactly the kind of thing a modified client would ignore.
     * `request.time` is the server's clock, so a device with the wrong date
     * doesn't get to enter late either.
     */
    function entryOpen(competition) {
      return competition.published == true
        && (competition.startsAt == null || request.time >= competition.startsAt)
        && (competition.endsAt == null || request.time <= competition.endsAt);
    }

    /**
     * A post may carry a challenge or tournament id only if that competition
     * exists and is open. Null — the normal case — costs no read.
     */
    function entryAllowed(root, id) {
      return id == null
        || (exists(competitionPath(root, id))
            && entryOpen(get(competitionPath(root, id)).data));
    }

    function competitionPath(root, id) {
      return path('/databases/' + database + '/documents/' + root + '/' + id);
    }

    /**
     * Has `uid` blocked the caller?
     *
     * A block list is private — the blocked person is never told, and the read
     * rule denies them the collection outright. `exists()` inside a rule is
     * not subject to read rules, so this can enforce the block without ever
     * exposing it. That's what makes "you can't DM someone who blocked you"
     * possible without leaking that a block happened: the send just fails.
     */
    function hasBlockedMe(uid) {
      return exists(
        /databases/$(database)/documents/users/$(uid)/blocked/$(request.auth.uid)
      );
    }

    /**
     * A suspended or banned account can still read and can still sign in, but
     * cannot create anything. Only an admin can change `accountStatus` — the
     * profile update rule below excludes the field, so nobody can lift their
     * own ban.
     *
     * This costs one document read per write. That's the price of enforcing it
     * where it can't be bypassed, rather than in app code a modified client
     * would simply skip.
     */
    function accountActive() {
      // The `exists` check is not redundant: `get()` on a missing document
      // returns null, and reading `.data` off it is an evaluation error rather
      // than a clean deny. Someone mid-signup, or whose account was deleted in
      // another session, hits exactly that path.
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.accountStatus == 'active';
    }

    // ---------------------------------------------------------------------
    // users/{uid} — public profile
    // ---------------------------------------------------------------------
    match /users/{uid} {
      // Profiles are public so the feed can show who posted what.
      allow read: if isSignedIn();

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && isValidString(request.resource.data.username, 20)
        && request.resource.data.username.size() >= 3
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && isValidString(request.resource.data.bio, 200)
        // Counters always start at zero; only the server moves them after that.
        && request.resource.data.postCount == 0
        && request.resource.data.fishLoggedCount == 0
        && request.resource.data.points == 0
        && request.resource.data.followerCount == 0
        && request.resource.data.followingCount == 0
        // Nobody signs themselves up pre-banned or pre-cleared of a ban.
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.suspendedUntil == null;

      allow update: if isSelf(uid)
        // Owners may edit presentation fields only. Counters and uid are
        // server-managed; username changes also touch /usernames, which has
        // its own rules below.
        && changedKeys().hasOnly([
             'bio', 'photoURL', 'favoriteSpecies', 'username', 'usernameLower',
             'providers', 'updatedAt'
           ])
        && (!changedKeys().hasAny(['bio']) || isValidString(request.resource.data.bio, 200))
        && (!changedKeys().hasAny(['username']) || (
             isValidString(request.resource.data.username, 20)
             && request.resource.data.username.size() >= 3
             && request.resource.data.usernameLower == request.resource.data.username.lower()
           ));

      // Moderation. An admin may change exactly two fields on somebody else's
      // profile and nothing else — not their bio, not their username, and not
      // their points. A moderation tool that can also rewrite a profile has a
      // bigger blast radius than the job needs.
      allow update: if isAdmin()
        && changedKeys().hasOnly(['accountStatus', 'suspendedUntil', 'updatedAt'])
        && request.resource.data.accountStatus in ['active', 'suspended', 'banned'];

      // "Delete account" removes the profile as the user, together with their
      // username reservation, so the name is released immediately. Cascading
      // cleanup of posts and photos is handled by a Cloud Function.
      // An admin can also remove an account outright.
      allow delete: if isSelf(uid) || isAdmin();

      // users/{uid}/private/profile — email, notification prefs.
      match /private/{document=**} {
        allow read, write: if isSelf(uid);
      }

      // users/{uid}/pushTokens/{token} — one per device.
      match /pushTokens/{token} {
        allow read, write: if isSelf(uid);
      }

      // users/{uid}/notifications/{id} — written by Cloud Functions; the user
      // may read them and mark them read.
      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid) && changedKeys().hasOnly(['readAt']);
        allow create, delete: if false;
      }

      // users/{uid}/pointsLedger/{entryId} — why the points total is what it
      // is. Private: what somebody earned and when is nobody else's business,
      // and the total on the public profile is the part meant to be seen.
      //
      // Written by Cloud Functions, except that an admin may file a manual
      // adjustment. Even Coop cannot edit the running total directly — the
      // function sums the ledger, so an intervention stays explainable.
      match /pointsLedger/{entryId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin()
          && request.resource.data.reason == 'admin_adjustment'
          && request.resource.data.amount is int;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // users/{uid}/badges/{badgeId} — awards. Public, because a badge you
      // can't show anyone isn't a badge. Written only by the Cloud Function
      // that checks thresholds; an award you can grant yourself is worthless.
      match /badges/{badgeId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      // users/{uid}/blocked/{blockedUid} — private to the owner.
      //
      // Deliberately not readable by the person who was blocked: they are
      // never told, which is the whole point of a block rather than a ban.
      match /blocked/{blockedUid} {
        allow read, write: if isSelf(uid);
      }

      // users/{uid}/wishlist/{productId} — entirely the owner's own list.
      match /wishlist/{productId} {
        allow read, write: if isSelf(uid);
      }

      // users/{uid}/orders/{orderId}
      //
      // The client records an order when checkout opens, but everything after
      // that — order number, status, tracking — is written by the Cloud
      // Function that receives Shopify's webhooks. Letting a client set its
      // own order to "fulfilled" would make the whole screen meaningless.
      match /orders/{orderId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.status == 'placed'
          && request.resource.data.shopifyOrderId == null
          && request.resource.data.orderNumber == null
          && request.resource.data.statusUrl == null
          && request.resource.data.cartId is string;
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // usernames/{usernameLower} — uniqueness reservations
    // ---------------------------------------------------------------------
    match /usernames/{usernameLower} {
      // Readable so the sign-up screen can check availability before writing.
      allow read: if true;
      // You may only claim a name for yourself, and only if it's unclaimed.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Releasing your own reservation (part of a rename transaction).
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      // Re-writing a reservation you already own — happens when profile
      // setup is retried after a partial failure. Never a takeover.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // admins/{uid}
    // ---------------------------------------------------------------------
    match /admins/{uid} {
      // A user may check whether they themselves are an admin, nothing more.
      allow get: if isSelf(uid);
      allow list, write: if false;
    }

    // ---------------------------------------------------------------------
    // follows/{followerId}_{followingId}
    // ---------------------------------------------------------------------
    match /follows/{edgeId} {
      // Public so a profile can show follower and following lists.
      allow read: if isSignedIn();

      // You can only create an edge where you are the follower, and the
      // document id has to match — otherwise one write could claim any edge.
      allow create: if accountActive()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && edgeId == request.auth.uid + '_' + request.resource.data.followingId;

      // Unfollowing is yours. So is being unfollowed — a user can remove a
      // follower, which is what "remove follower" means on every other app.
      allow delete: if isSignedIn() && (
           resource.data.followerId == request.auth.uid
           || resource.data.followingId == request.auth.uid
         );

      // Counters are derived from these edges; editing one would desync them.
      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // stats/{id} — dashboard totals, maintained by Cloud Functions.
    //
    // Admin-readable only: these are business numbers, not something anglers
    // need, and a user count is the kind of thing a competitor screenshots.
    // ---------------------------------------------------------------------
    match /stats/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // config/{document} — remote config.
    //
    // Readable by every signed-in user because the app acts on it; writable
    // only by an admin. Nothing here grants permission — these are switches
    // for behaviour, and the rules remain the only thing deciding access. A
    // flag that granted access would be a flag anyone could read and forge
    // around, since the client is the side reading it.
    // ---------------------------------------------------------------------
    match /config/{document} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // events/{eventId} — the calendar. Admin-authored, same draft rule as
    // articles: unpublished is invisible to everyone but an admin.
    // ---------------------------------------------------------------------
    match /events/{eventId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.published == true);

      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && isValidString(request.resource.data.title, 100)
        && request.resource.data.title.size() > 0
        && isValidString(request.resource.data.description, 2000)
        && isValidString(request.resource.data.location, 200)
        && request.resource.data.startsAt is timestamp;

      allow update: if isAdmin()
        && isValidString(request.resource.data.title, 100)
        && request.resource.data.title.size() > 0
        && isValidString(request.resource.data.description, 2000);

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // badges/{badgeId} — definitions, not awards.
    //
    // Data-driven on purpose: the awarding function reads these and awards any
    // whose threshold a profile has crossed, so a new badge is a document
    // rather than a deploy. Awards live under each user and are server-only.
    // ---------------------------------------------------------------------
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && isValidString(request.resource.data.title, 60)
        && request.resource.data.title.size() > 0
        && isValidString(request.resource.data.description, 200)
        && request.resource.data.metric in
             ['postCount', 'points', 'followerCount', 'fishLoggedCount']
        && request.resource.data.threshold is int
        && request.resource.data.threshold >= 1;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // challenges/{id} and tournaments/{id}
    //
    // Same shape, same rules, written once and applied to both roots. Entries
    // are posts carrying the id — see the `posts` rules for that side.
    // ---------------------------------------------------------------------

    function competitionCreate() {
      return isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && isValidString(request.resource.data.title, 100)
        && request.resource.data.title.size() > 0
        && isValidString(request.resource.data.description, 2000)
        && request.resource.data.scoring in ['most_likes', 'admin_pick']
        // Derived from the entries; a competition that could open claiming 400
        // entries would make the number meaningless.
        && request.resource.data.entryCount == 0
        && request.resource.data.winnerPostId == null
        && request.resource.data.winnerUid == null;
    }

    function competitionUpdate() {
      return isAdmin()
        && isValidString(request.resource.data.title, 100)
        && isValidString(request.resource.data.description, 2000)
        // `entryCount` is server-written. An admin editing the prize text must
        // not be able to move it, deliberately or by sending a stale document.
        && request.resource.data.entryCount == resource.data.entryCount;
    }

    match /challenges/{competitionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.published == true);
      allow create: if competitionCreate();
      allow update: if competitionUpdate();
      allow delete: if isAdmin();
    }

    match /tournaments/{competitionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.published == true);
      allow create: if competitionCreate();
      allow update: if competitionUpdate();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // articles/{articleId} — tips, how-tos, and YouTube videos
    //
    // Admin-authored. Drafts are invisible to everyone but admins, so Coop can
    // write something over several sittings without it leaking half-finished.
    // ---------------------------------------------------------------------
    match /articles/{articleId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.published == true);

      allow create: if isAdmin()
        && request.resource.data.authorId == request.auth.uid
        && isValidString(request.resource.data.title, 120)
        && request.resource.data.title.size() > 0
        && isValidString(request.resource.data.summary, 300)
        && isValidString(request.resource.data.body, 20000)
        && request.resource.data.kind in ['article', 'video'];

      allow update: if isAdmin()
        && isValidString(request.resource.data.title, 120)
        && isValidString(request.resource.data.summary, 300)
        && isValidString(request.resource.data.body, 20000);

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Reviews — productReviews/{handle} and baitReviews/{slug}
    //
    // Identical rules for both, so they're written once here and applied to
    // each root below. The shape that matters:
    //
    //   * the review document id IS the author's uid, which is what enforces
    //     one review per person per thing — you cannot stack five;
    //   * `reviewCount`, `ratingSum` and `ratingAverage` on the summary are
    //     server-written, because an average a client can set is not a rating;
    //   * `verifiedPurchase` is server-written for the same reason.
    // ---------------------------------------------------------------------

    function reviewSummaryCreate() {
      return accountActive()
        && isValidString(request.resource.data.title, 200)
        && request.resource.data.title.size() > 0
        && request.resource.data.reviewCount == 0
        && request.resource.data.ratingSum == 0
        && request.resource.data.ratingAverage == 0;
    }

    function reviewWrite(subjectId, authorUid) {
      return accountActive()
        && isSelf(authorUid)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.subjectId == subjectId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && isValidString(request.resource.data.text, 1500)
        // A verified-purchase badge you can award yourself is worse than no
        // badge at all. A Cloud Function checks the order history and flips it.
        && request.resource.data.verifiedPurchase == false;
    }

    match /productReviews/{subjectId} {
      allow read: if isSignedIn();
      allow create: if reviewSummaryCreate();
      // Counts and averages are derived from the reviews below.
      allow update: if false;
      allow delete: if isAdmin();

      match /reviews/{authorUid} {
        allow read: if isSignedIn();
        allow create, update: if reviewWrite(subjectId, authorUid);
        allow delete: if isSelf(authorUid) || isAdmin();
      }
    }

    match /baitReviews/{subjectId} {
      allow read: if isSignedIn();
      allow create: if reviewSummaryCreate();
      allow update: if false;
      allow delete: if isAdmin();

      match /reviews/{authorUid} {
        allow read: if isSignedIn();
        allow create, update: if reviewWrite(subjectId, authorUid);
        allow delete: if isSelf(authorUid) || isAdmin();
      }
    }

    // ---------------------------------------------------------------------
    // conversations/{conversationId} — private messages
    //
    // The document id is the two uids sorted and joined with '_'. That's
    // enforced here, not just in the app: without it one write could create a
    // thread whose id doesn't match its participants, and every later lookup
    // by id would miss it.
    // ---------------------------------------------------------------------
    match /conversations/{conversationId} {

      function participants() {
        return resource.data.participantIds;
      }

      function isParticipant() {
        return isSignedIn() && request.auth.uid in participants();
      }

      // Admins can read threads so a reported message can actually be looked
      // at. Reading is all they get — an admin cannot send as somebody else.
      allow read: if isParticipant() || isAdmin();

      allow create: if accountActive()
        && request.resource.data.participantIds is list
        // Exactly two for now. Group threads are a data change, not a schema
        // change: relax this and the id rule below.
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        // Sorted, so the id is the same from both sides. Without this the two
        // participants could each create a thread under a different id and
        // neither would see the other's messages.
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && conversationId == request.resource.data.participantIds.join('_')
        // A fresh thread starts empty. Forging a preview or an unread badge
        // into existence is exactly the kind of thing a modified client would
        // try.
        && request.resource.data.lastMessage == null
        && request.resource.data.lastMessageAt == null
        && request.resource.data.unread.values().hasOnly([0])
        // You cannot open a thread with somebody who has blocked you. `get`
        // and `exists` are not subject to read rules, so this can check a
        // list the sender is never allowed to see.
        && !hasBlockedMe(otherIn(request.resource.data.participantIds));

      // The only edit a participant may make is zeroing their own unread
      // count. Everything else on this document — the preview, the timestamp,
      // the other side's count — is written by a Cloud Function.
      allow update: if isParticipant()
        && changedKeys().hasOnly(['unread'])
        && request.resource.data.unread[request.auth.uid] == 0
        && request.resource.data.unread
             .diff(resource.data.unread)
             .affectedKeys()
             .hasOnly([request.auth.uid]);

      // Leaving a thread would delete it for the other person too. Hiding a
      // conversation is what blocking is for.
      allow delete: if isAdmin();

      match /messages/{messageId} {

        function thread() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function inThread() {
          return isSignedIn() && request.auth.uid in thread().participantIds;
        }

        allow read: if inThread() || isAdmin();

        allow create: if accountActive()
          && inThread()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.conversationId == conversationId
          && isValidString(request.resource.data.text, 2000)
          && request.resource.data.text.size() > 0
          && request.resource.data.removedAt == null
          && request.resource.data.removedBy == null
          // Re-checked on every message, not just when the thread opened —
          // otherwise a block would only stop new conversations, not the one
          // already in progress.
          && !hasBlockedMe(otherIn(thread().participantIds));

        // A sent message can't be edited into something else after the fact;
        // the recipient has already read it. Admins tombstone instead, which
        // keeps the document so a report stays auditable.
        allow update: if isAdmin()
          && changedKeys().hasOnly(['text', 'removedAt', 'removedBy', 'updatedAt'])
          && request.resource.data.removedBy == request.auth.uid;

        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.senderId == request.auth.uid);
      }
    }

    // ---------------------------------------------------------------------
    // reports/{reportId}
    //
    // A reporter may file one and nothing else. They cannot read the queue,
    // edit their report, or see the outcome — any of those would reveal who
    // reported whom, which is exactly what a reporting system must not do.
    // ---------------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAdmin();

      allow create: if accountActive()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['post', 'comment', 'user', 'message']
        && request.resource.data.targetId is string
        && request.resource.data.targetOwnerId is string
        // Reporting yourself is meaningless and would only muddy the queue.
        && request.resource.data.targetOwnerId != request.auth.uid
        && isValidString(request.resource.data.note, 500)
        && request.resource.data.status == 'open'
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null;

      allow update: if isAdmin()
        && changedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'updatedAt'])
        && request.resource.data.status in ['actioned', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid;

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // announcements/{announcementId}
    //
    // Creating one is what triggers the fan-out to every registered device, so
    // only an admin may write here. Everyone can read them so the app can show
    // a "news" list without waiting on a push.
    // ---------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && isValidString(request.resource.data.title, 100)
        && request.resource.data.title.size() > 0
        && isValidString(request.resource.data.body, 500)
        && request.resource.data.body.size() > 0
        // `sentAt` and `recipientCount` are the Cloud Function's to set — an
        // announcement that claims to have already been sent would never go out.
        && request.resource.data.sentAt == null
        && request.resource.data.recipientCount == 0;
      // Editing after the push has gone out would leave the two disagreeing.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // posts/{postId}
    // ---------------------------------------------------------------------
    match /posts/{postId} {

      function isApproved() {
        return resource.data.status == 'approved';
      }

      function isAuthor() {
        return isSignedIn() && resource.data.authorId == request.auth.uid;
      }

      // Search keywords come from the client, so cap them. MAX_KEYWORDS in
      // src/lib/search.ts is 40 — keep the two in step.
      //
      // Absence passes: a post without keywords simply doesn't turn up in
      // search, which is a feature gap and not a security problem. Requiring
      // the field would instead make every pre-search post uneditable.
      function validKeywords() {
        return !('keywords' in request.resource.data)
          || (request.resource.data.keywords is list
              && request.resource.data.keywords.size() <= 40);
      }

      // Signed-in users see approved posts; you can always see your own (so
      // you can watch it move through review); admins see everything.
      // Sign-in is required deliberately — the whole app is behind auth, and
      // without this check anyone with the public API key could scrape the
      // feed. Relax it only if there's ever a public web version.
      allow read: if isSignedIn() && (isApproved() || isAuthor() || isAdmin());

      allow create: if accountActive()
        && request.resource.data.authorId == request.auth.uid
        // Nothing goes live without review.
        && request.resource.data.status == 'pending'
        && request.resource.data.publishedAt == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && isValidString(request.resource.data.caption, 2000)
        && request.resource.data.media.url is string
        && request.resource.data.media.storagePath is string
        && request.resource.data.media.kind in ['photo', 'video']
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.reportCount == 0
        // Search keywords are client-computed, so they need a ceiling — a huge
        // array is a cheap way to bloat the document and the index.
        && validKeywords()
        // Entering a competition is decided at post time, and only into one
        // that's actually running.
        && entryAllowed('challenges', request.resource.data.challengeId)
        && entryAllowed('tournaments', request.resource.data.tournamentId)
        // Only an admin decides what gets featured.
        && request.resource.data.featured == false;

      // Authors may fix a caption, but only while the post is still pending —
      // an approved post can't be edited into something else after the fact.
      // `keywords` rides along because it's derived from the caption and the
      // species; leaving it out would let an edit desync search from content.
      allow update: if isAuthor()
        && resource.data.status == 'pending'
        && changedKeys().hasOnly([
             'caption', 'species', 'speciesSlug', 'keywords', 'updatedAt'
           ])
        && isValidString(request.resource.data.caption, 2000)
        && validKeywords();

      // Moderation. Only admins, and only into a terminal state.
      allow update: if isAdmin()
        && changedKeys().hasOnly([
             'status', 'publishedAt', 'reviewedAt', 'reviewedBy', 'reviewNote', 'updatedAt'
           ])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;

      // Featuring a post on the home page. Separate from review so an admin
      // can pin something without it counting as a fresh moderation decision.
      allow update: if isAdmin() && changedKeys().hasOnly(['featured', 'updatedAt']);

      allow delete: if isAuthor() || isAdmin();

      // posts/{postId}/likes/{uid} — document id is the liker.
      match /likes/{likerId} {
        allow read: if isSignedIn();
        // Only on approved posts, only your own like. Removing a like is
        // allowed even while suspended — undoing something is never the
        // behaviour a ban is meant to stop.
        allow create: if isSelf(likerId)
          && accountActive()
          && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'approved';
        allow delete: if isSelf(likerId);
        allow update: if false;
      }

      // posts/{postId}/comments/{commentId}
      match /comments/{commentId} {
        allow read: if isSignedIn();

        allow create: if accountActive()
          && request.resource.data.authorId == request.auth.uid
          && isValidString(request.resource.data.text, 1000)
          && request.resource.data.text.size() > 0
          && get(/databases/$(database)/documents/posts/$(postId)).data.status == 'approved';

        allow update: if isSignedIn()
          && resource.data.authorId == request.auth.uid
          && changedKeys().hasOnly(['text', 'updatedAt'])
          && isValidString(request.resource.data.text, 1000);

        // Your own comment, or anything on a post you own, or admin.
        allow delete: if isSignedIn() && (
             resource.data.authorId == request.auth.uid
             || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
             || isAdmin()
           );
      }
    }

    // Anything not matched above is denied. Later phases (follows, messages,
    // tournaments, badges) add their own blocks here.
  }
}
